{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "CLAUDE.md",
      "docs/**",
      "tools/**",
      "まじゃすこ素材/**",
      "**/.*",
      "**/.*/**",
      "**/node_modules/**",
      "README.md",
      "tests.html"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          },
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          },
          {
            "key": "X-Frame-Options",
            "value": "SAMEORIGIN"
          },
          {
            "key": "Content-Security-Policy",
            "value": "frame-ancestors 'self'; base-uri 'self'; object-src 'none'"
          },
          {
            "key": "Permissions-Policy",
            "value": "camera=(), microphone=(), geolocation=()"
          }
        ]
      },
      {
        "source": "**/*.mp4",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "public, max-age=86400"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/changelog.html",
        "destination": "/news/",
        "type": 301
      },
      {
        "source": "/blog-fu-han.html",
        "destination": "/blog-score-table.html#fu",
        "type": 301
      },
      {
        "source": "/blog-hai-types.html",
        "destination": "/blog-rule-basics.html#hai",
        "type": 301
      },
      {
        "source": "/blog-riichi.html",
        "destination": "/blog-yaku-list.html#riichi",
        "type": 301
      },
      {
        "source": "/blog-dora.html",
        "destination": "/blog-yaku-list.html#dora",
        "type": 301
      },
      {
        "source": "/blog-naki.html",
        "destination": "/blog-yaku-list.html#naki",
        "type": 301
      },
      {
        "source": "/blog-starter-kit.html",
        "destination": "/blog-manner.html#starter-kit",
        "type": 301
      },
      {
        "source": "/assets/score/tensu-hayamihyo.png",
        "destination": "/assets/score/mahjong-tensu-hayamihyo.png",
        "type": 301
      },
      {
        "source": "/assets/score/tensu-hayamihyo-web.png",
        "destination": "/assets/score/mahjong-tensu-hayamihyo-web.png",
        "type": 301
      },
      {
        "source": "/assets/score/tensu-hayamihyo.pdf",
        "destination": "/assets/score/mahjong-tensu-hayamihyo.pdf",
        "type": 301
      },
      {
        "source": "/assets/score/tensu-ko.png",
        "destination": "/assets/score/mahjong-tensu-ko.png",
        "type": 301
      },
      {
        "source": "/assets/score/tensu-oya.png",
        "destination": "/assets/score/mahjong-tensu-oya.png",
        "type": 301
      },
      {
        "source": "/assets/score/tensu-mangan.png",
        "destination": "/assets/score/mahjong-tensu-mangan.png",
        "type": 301
      },
      {
        "source": "/assets/score/fu-keisan.png",
        "destination": "/assets/score/mahjong-fu-keisan.png",
        "type": 301
      },
      {
        "source": "/assets/hai/yaku-ichiran.png",
        "destination": "/assets/hai/mahjong-yaku-ichiran.png",
        "type": 301
      },
      {
        "source": "/assets/hai/yaku-ichiran-web.png",
        "destination": "/assets/hai/mahjong-yaku-ichiran-web.png",
        "type": 301
      },
      {
        "source": "/assets/hai/yaku-ichiran.pdf",
        "destination": "/assets/hai/mahjong-yaku-ichiran.pdf",
        "type": 301
      },
      {
        "source": "/assets/hai/local-yaku-ichiran.png",
        "destination": "/assets/hai/mahjong-local-yaku-ichiran.png",
        "type": 301
      },
      {
        "source": "/assets/hai/local-yaku-ichiran-web.png",
        "destination": "/assets/hai/mahjong-local-yaku-ichiran-web.png",
        "type": 301
      },
      {
        "source": "/assets/hai/local-yaku-ichiran.pdf",
        "destination": "/assets/hai/mahjong-local-yaku-ichiran.pdf",
        "type": 301
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
