{
  "hosting": {
    "public": ".",
    "ignore": [
      "firebase.json",
      "database.rules.json",
      "CLAUDE.md",
      "docs/**",
      "tools/**",
      "まじゃすこ素材/**",
      "**/.*",
      "**/node_modules/**",
      "README.md"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      }
    ],
    "redirects": [
      {
        "source": "/blog-fu-han.html",
        "destination": "/blog-score-table.html#fu",
        "type": 301
      },
      {
        "source": "/blog-hai-types.html",
        "destination": "/blog-rule-basics.html#hai",
        "type": 301
      }
    ]
  },
  "database": {
    "rules": "database.rules.json"
  }
}
